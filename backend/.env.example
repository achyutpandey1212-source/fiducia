# Server Configuration
PORT=4000
NODE_ENV=development
APP_VERSION=fiducia-v1.0.0

# MongoDB Atlas M0 Cluster Connection
MONGODB_URI=mongodb+srv://<username>:<password>@fiducia-cluster.mongodb.net/fiducia?retryWrites=true&w=majority
MONGODB_DB_NAME=fiducia

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=fiducia-wealth
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@fiducia-wealth.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
ENABLE_DEMO_BYPASS=true

# Unified AI Gateway Key Pools (Comma-Separated for Adaptive Rotation)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# Render Zero-Cold-Start Keep-Alive Self-Ping URL
PUBLIC_API_URL=http://localhost:4000
KEEP_ALIVE_INTERVAL_MS=600000
